# The browser tests the pushed commits reach: since the branch's upstream, or
# its copy on origin, or since main on a branch's first push. Plain --changed
# would compare against uncommitted changes, which a push has none of.
branch=$(git branch --show-current)
base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) ||
	base=$(git rev-parse --verify --quiet "origin/$branch" >/dev/null && echo "origin/$branch") ||
	base=origin/main
vp test run --changed "$base" --project desktop --project mobile --bail 1 --passWithNoTests
