# The shared "Desktop app" Google client, which accepts any loopback port.
GOOGLE_CLIENT_ID=vaultSecret("secret/shared/development")
GOOGLE_CLIENT_SECRET=vaultSecret("secret/shared/development")

# Auth talks to the daemon directly, not through the proxy URL.
BETTER_AUTH_URL=http://localhost:${APP_PORT}

# Google sign-in goes through the shared OAuth broker in the platform project,
# which has one stable callback URL, so any workspace or preview URL works. Its
# credentials are read from the broker's own OpenBao path; nothing is copied.
OAUTH_BROKER_URL="https://oauth-broker-production-b170.up.railway.app"
OAUTH_BROKER_GOOGLE_CLIENT_ID=vaultSecret("secret/oauth-broker/production#GOOGLE_CLIENT_ID")
OAUTH_BROKER_GOOGLE_CLIENT_SECRET=vaultSecret("secret/oauth-broker/production#GOOGLE_CLIENT_SECRET")
OAUTH_BROKER_SECRET=vaultSecret("secret/oauth-broker/production#OAUTH_PROXY_SECRET")

# The assistant's model calls, through OpenRouter. Only the cocochef dev
# token can read secret/cocochef/development; without it, the mocks answer.
OPENROUTER_API_KEY=if($OPENBAO_APP_TOKEN, vaultSecret())

# Jev, for recipe tags; the key is shared across apps.
TYPESAFE_API_KEY=vaultSecret("secret/shared/development")
