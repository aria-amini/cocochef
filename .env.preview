GOOGLE_CLIENT_ID="226948588184-bb1fpk1qijd3hbdefae19ailjp06825t.apps.googleusercontent.com"

# Read from OpenBao: secret/dutch-oven/<env>.
BETTER_AUTH_SECRET=vaultSecret()
OAUTH_PROXY_SECRET=vaultSecret()
GOOGLE_CLIENT_SECRET=vaultSecret()


# Google sign-in goes through the shared OAuth broker in the platform project,
# which has one stable callback URL, so any workspace or preview URL works. Its
# credentials are read from the broker's own OpenBao path; nothing is copied.
OAUTH_BROKER_URL="https://oauth-broker-production-b170.up.railway.app"
OAUTH_BROKER_GOOGLE_CLIENT_ID=vaultSecret("secret/oauth-broker/production#GOOGLE_CLIENT_ID")
OAUTH_BROKER_GOOGLE_CLIENT_SECRET=vaultSecret("secret/oauth-broker/production#GOOGLE_CLIENT_SECRET")
OAUTH_BROKER_SECRET=vaultSecret("secret/oauth-broker/production#OAUTH_PROXY_SECRET")
